<%- include('partials/header') %>
<main>
  <div class="contenedor w-50 mx-auto bg-white p-4 rounded shadow mt-5">
    <h3 class="link-secondary">Busqueda del Personal</h3>
    <form class="mb-4" action="/buscar" method="post">
      <div class="row">
        <div class="col">
          <div class="form-group">
            <label for="cedula" class="link-secondary">Cédula:</label>
            <input
              type="text"
              class="form-control"
              id="cedula"
              name="cedula"
              placeholder="Ingrese..."
              required
            />
          </div>
        </div>
        <div class="col">
          <button
            type="button"
            class="btn btn-primary mt-4"
            onclick="buscarPersonal()"
          >
            Buscar
          </button>
        </div>
      </div>
    </form>
  </div>
  <div
    class="modal fade"
    id="exampleModal"
    tabindex="-1"
    aria-labelledby="exampleModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="exampleModalLabel">
            Ficha de Trabajador
          </h1>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body" id="modal-contenido"></div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>
</main>
<script>
  async function buscarPersonal() {
    // console.log("1. Función iniciada");
    const cedula = document.getElementById("cedula").value;
    const modalElement = document.getElementById("exampleModal");
    const contenidoModal = document.getElementById("modal-contenido");
    const titulo = document.getElementById("exampleModalLabel");
    try {
      // console.log("2. Enviando petición...");
      const response = await fetch("/buscar", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `cedula=${cedula}`,
      });

      const html = await response.text();
      // console.log("3. Respuesta recibida, inyectando...");
      contenidoModal.innerHTML = html;

      // console.log("4. Intentando abrir modal...");
      // Usamos la forma nativa de Bootstrap 5 para abrir
      const modal = new bootstrap.Modal(modalElement);
      modal.show();
      //  console.log("5. ¡Comando show enviado!");
    } catch (err) {
      console.error("ERROR CRÍTICO:", err);
    }
  }
</script>
<script>
  // Permite buscar presionando la tecla "Enter"
  document.getElementById("cedula").addEventListener("keypress", function (e) {
    if (e.key === "Enter") {
      e.preventDefault(); // Evita que el formulario se envíe solo
      buscarPersonal(); // Llama a tu función de búsqueda
    }
  });
</script>
<%- include('partials/footer') %>
