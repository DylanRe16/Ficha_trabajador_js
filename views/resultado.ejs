<% if (typeof usuario !== 'undefined' && usuario) { %>
<p>Nombres: <%= usuario.primer_nombre %> <%= usuario.segundo_nombre %></p>
<p>Apellidos: <%= usuario.primer_apellido %> <%= usuario.segundo_apellido %></p>
<p>Cédula: <%= usuario.cedula %></p>
<p>Cargo: <%= usuario.scargo_actual_ejerce %></p>
<% } else { %>
<p>No se encontró información para la cédula ingresada.</p>
<% } %>
