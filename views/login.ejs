<%- include('partials/header') %>
<main
  class="form-signin w-100 m-auto mt-5 shadow border-top border-primary border-4 rounded-2"
>
  <% if (typeof error !== 'undefined') { %>
  <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <form action="/login" method="POST">
    <h1 class="h3 mb-3 fw-normal">Inicia sesión</h1>
    <hr />
    <div class="form-floating">
      <input
        name="cedula"
        type="text"
        class="form-control rounded"
        id="floatingInput"
        placeholder="12.345.678"
      />
      <label for="floatingInput">Cédula</label>
    </div>
    <div class="form-floating">
      <input
        name="password"
        type="password"
        class="form-control rounded"
        id="floatingPassword"
        placeholder="Contraseña"
      />
      <label for="floatingPassword">Contraseña</label>
    </div>
    <!-- <div class="form-check text-start my-3">
          <input
            class="form-check-input"
            type="checkbox"
            value="remember-me"
            id="checkDefault"
          />
          <label class="form-check-label" for="checkDefault">
            Remember me
          </label>
        </div> -->
    <button class="btn btn-primary w-100 py-2" type="submit">Iniciar</button>
    <!-- <p class="mt-5 mb-3 text-body-secondary">&copy; 2026</p> -->
  </form>
</main>
<%- include('partials/footer') %>
